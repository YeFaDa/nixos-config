+const OPENCODE_GO_SESSION_HEADER = 'x-opencode-session';
+
+function isOpenCodeGoBaseUrl(baseUrl: string | undefined): boolean {
+  if (baseUrl === undefined) return false;
+  try {
+    const url = new URL(baseUrl);
+    const host = url.hostname.toLowerCase();
+    const path = url.pathname.replace(/\/+$/, '').toLowerCase();
+    return (host === 'opencode.ai' || host.endsWith('.opencode.ai')) && path === '/zen/go/v1';
+  } catch {
+    return false;
+  }
+}
+
+function withOpenCodeGoSessionHeader(
+  request: OpenAIResponsesRequestParams,
+  baseUrl: string | undefined,
+  cacheKey: string | undefined,
+): OpenAIResponsesRequestParams {
+  if (cacheKey === undefined || !isOpenCodeGoBaseUrl(baseUrl)) {
+    return request;
+  }
+  return {
+    ...request,
+    headers: {
+      ...request.headers,
+      [OPENCODE_GO_SESSION_HEADER]: cacheKey.replace(/^session_/, ''),
+    },
+  };
+}
